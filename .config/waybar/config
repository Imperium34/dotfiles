{
  "layer": "top",
  "position": "top",
  "height": 30,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 0,
  "modules-left": [
    "custom/power",
    "hyprland/workspaces",
    "custom/media"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "idle_inhibitor",
    "pulseaudio",
    "backlight",
    "network",
    "bluetooth",
    "battery",
    "tray",
    "custom/notification"
  ],
  // -----------------------------------------------------
  // Left Modules
  // -----------------------------------------------------
  "custom/power": {
    "format": " 󰐥 ",
    "tooltip": false,
    "on-click": "wlogout"
  },
  "hyprland/workspaces": {
    "format": "{name} {windows}",
    "window-rewrite": {
      "class<firefox>": "",
      "class<zen>": "󰈹",
      "class<code>": "󰨞",
      "class<code-oss>": "󰨞",
      "class<alacritty>": "",
      "class<thunar>": "󰉋",
      "class<spotify>": ""
    },
    "window-rewrite-separator": " ",
    "format-window-separator": " ",
    "sort-by-number": true,
    "active-only": false
  },
  "custom/media": {
    "format": "{}",
    "return-type": "json",
    "max-length": 50,
    "exec": "~/.config/hypr/scripts/media-player.py --waybar 2> /dev/null",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "interval": 1,
    "smooth-scrolling-threshold": 10
  },
  // -----------------------------------------------------
  // Center Modules
  // -----------------------------------------------------
  "clock": {
    "format": "{:%H:%M %p}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "today-format": "<b>{}</b>"
  },
  // -----------------------------------------------------
  // Right Modules
  // -----------------------------------------------------
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "tooltip": true
  },
  "pulseaudio": {
    "scroll-step": 2,
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% {icon}",
    "format-bluetooth-muted": "󰝟 {icon}",
    "format-muted": "󰝟",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol",
    "on-click-right": "swayosd-client --output-volume mute-toggle"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{percent}% {icon} ",
    "format-icons": [
      "",
      "󰖨"
    ],
    "on-scroll-up": "swayosd-client --brightness raise",
    "on-scroll-down": "swayosd-client --brightness lower"
  },
  "network": {
    "format-wifi": " ",
    "format-ethernet": "",
    "format-linked": "{ifname} (No IP) ",
    "format": "",
    "format-disconnected": "󰖪",
    "on-click": "networkmanager_dmenu --style .config/wofi/style.css",
    "tooltip-format": " {bandwidthUpBits}  {bandwidthDownBits}\n{ifname}\n{ipaddr}/{cidr}",
    "tooltip-format-wifi": " {essid} {frequency}MHz\nStrength: {signaldBm}dBm ({signalStrength}%)\nIP: {ipaddr}/{cidr}\n {bandwidthUpBits}  {bandwidthDownBits}",
    "interval": 10
  },
  "bluetooth": {
    "format": "",
    "format-connected": " {device_alias}",
    "format-connected-battery": " {device_alias} {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "on-click": "alacritty --class bluetui --hold -e bluetui",
    "on-click-right": "rfkill toggle bluetooth"
  },
  "battery": {
    "device": "BAT0",
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "interval": 1,
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% {icon}󱐋",
    "format-plugged": "{capacity}% {icon}",
    "tooltip": true,
    "tooltip-format": "{time} remaining\n{power:.1f}W getting used",
    "tooltip-format-charging": "Charging... ({time} to full)",
    "tooltip-format-critical": "Battery Critical: Please plug in.",
    "format-icons": [
      "󰂎",
      "󰁻",
      "󰁽",
      "󰁿",
      "󰂁",
      "󰁹"
    ]
  },
  "tray": {
    "icon-size": 15,
    "spacing": 5
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}
