{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "cachyos_small",
    "padding": {
      "top": 4,
      "left": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "blue"
    },
    "size": {
      "binaryPrefix": "si",
      "ndigits": 2
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "green",
        "at": "red",
        "host": "blue"
      }
    },
    "break",
    {
      "type": "os",
      "key": " ",
      "keyColor": "blue"
    },
    {
      "type": "command",
      "key": " ",
      "keyColor": "yellow",
      // Calculates days since root folder creation
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": " ",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "cyan"
    },
    "break",
    {
      "type": "cpu",
      "key": " ",
      "keyColor": "blue",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "󰢮 ",
      "keyColor": "green",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": " ",
      "keyColor": "yellow"
    },
    {
      "type": "disk",
      "key": " ",
      "keyColor": "magenta",
      "folders": "/"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
