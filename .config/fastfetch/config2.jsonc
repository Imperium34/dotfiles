{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "cachyos_small",
    "padding": {
      "top": 4,
      "left": 2
    }
  },
  "display": {
    "separator": "  ➜  ",
    "color": {
      "separator": "blue"
    }
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": " OS",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": " VER",
      "keyColor": "green"
    },
    {
      "type": "command",
      "key": " AGE",
      "keyColor": "yellow",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    {
      "type": "packages",
      "key": " PKG",
      "keyColor": "yellow"
    },
    {
      "type": "uptime",
      "key": " UP",
      "keyColor": "red"
    },
    "break",
    {
      "type": "cpu",
      "key": " CPU",
      "keyColor": "cyan",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "magenta",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": " RAM",
      "keyColor": "white"
    },
    "break",
    {
      "type": "shell",
      "key": " SH",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": " WM",
      "keyColor": "green"
    },
    "break",
    "colors"
  ]
}
