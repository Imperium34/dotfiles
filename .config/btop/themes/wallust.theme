# Btop Wallust Theme

# Main background
theme[main_bg]="#110E22"

# Main text color
theme[main_fg]="#BEB3B2"

# Title color for boxes
theme[title]="#BEB3B2"

# Highlight color for selected items
theme[hi_fg]="#0A8BAC"

# Background color of selected item
theme[selected_bg]="#6B6060"

# Text color of selected item
theme[selected_fg]="#9A8A89"

# Color of inactive/disabled text
theme[inactive_fg]="#6B6060"

# Color of text appearing on top of graphs
theme[graph_text]="#BEB3B2"

# Misc colors for processes, etc.
theme[proc_misc]="#19E5C1"

# Cpu box outline color
theme[cpu_box]="#0A8BAC"

# Memory box outline color
theme[mem_box]="#556108"

# Net box outline color
theme[net_box]="#0F994E"

# Proc box outline color
theme[proc_box]="#BD9E13"

# Box divider line and small boxes line color
theme[div_line]="#6B6060"

# Temperature graph colors
theme[temp_start]="#556108"
theme[temp_mid]="#0F994E"
theme[temp_end]="#074145"

# CPU graph colors
theme[cpu_start]="#556108"
theme[cpu_mid]="#0A8BAC"
theme[cpu_end]="#19E5C1"

# Mem/Disk free meter
theme[free_start]="#556108"
theme[free_mid]="#556108"
theme[free_end]="#556108"

# Mem/Disk cached meter
theme[cached_start]="#0A8BAC"
theme[cached_mid]="#0A8BAC"
theme[cached_end]="#0A8BAC"

# Mem/Disk available meter
theme[available_start]="#0F994E"
theme[available_mid]="#0F994E"
theme[available_end]="#0F994E"

# Mem/Disk used meter
theme[used_start]="#074145"
theme[used_mid]="#074145"
theme[used_end]="#074145"

# Download graph colors
theme[download_start]="#0A8BAC"
theme[download_mid]="#0A8BAC"
theme[download_end]="#19E5C1"

# Upload graph colors
theme[upload_start]="#0A8BAC"
theme[upload_mid]="#0A8BAC"
theme[upload_end]="#BD9E13"
