# Btop Wallust Theme

# Main background
theme[main_bg]="#233B4A"

# Main text color
theme[main_fg]="#B3C7CF"

# Title color for boxes
theme[title]="#B3C7CF"

# Highlight color for selected items
theme[hi_fg]="#B30F4F"

# Background color of selected item
theme[selected_bg]="#61747D"

# Text color of selected item
theme[selected_fg]="#8BA6B2"

# Color of inactive/disabled text
theme[inactive_fg]="#61747D"

# Color of text appearing on top of graphs
theme[graph_text]="#B3C7CF"

# Misc colors for processes, etc.
theme[proc_misc]="#FA622B"

# Cpu box outline color
theme[cpu_box]="#B30F4F"

# Memory box outline color
theme[mem_box]="#7B0F7F"

# Net box outline color
theme[net_box]="#850B0E"

# Proc box outline color
theme[proc_box]="#D45E15"

# Box divider line and small boxes line color
theme[div_line]="#61747D"

# Temperature graph colors
theme[temp_start]="#7B0F7F"
theme[temp_mid]="#850B0E"
theme[temp_end]="#762A08"

# CPU graph colors
theme[cpu_start]="#7B0F7F"
theme[cpu_mid]="#B30F4F"
theme[cpu_end]="#FA622B"

# Mem/Disk free meter
theme[free_start]="#7B0F7F"
theme[free_mid]="#7B0F7F"
theme[free_end]="#7B0F7F"

# Mem/Disk cached meter
theme[cached_start]="#B30F4F"
theme[cached_mid]="#B30F4F"
theme[cached_end]="#B30F4F"

# Mem/Disk available meter
theme[available_start]="#850B0E"
theme[available_mid]="#850B0E"
theme[available_end]="#850B0E"

# Mem/Disk used meter
theme[used_start]="#762A08"
theme[used_mid]="#762A08"
theme[used_end]="#762A08"

# Download graph colors
theme[download_start]="#B30F4F"
theme[download_mid]="#B30F4F"
theme[download_end]="#FA622B"

# Upload graph colors
theme[upload_start]="#B30F4F"
theme[upload_mid]="#B30F4F"
theme[upload_end]="#D45E15"
