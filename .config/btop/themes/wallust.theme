# Btop Wallust Theme

# Main background
theme[main_bg]="#100F10"

# Main text color
theme[main_fg]="#FAFBE1"

# Title color for boxes
theme[title]="#FAFBE1"

# Highlight color for selected items
theme[hi_fg]="#D28813"

# Background color of selected item
theme[selected_bg]="#A8A98F"

# Text color of selected item
theme[selected_fg]="#F0F1CC"

# Color of inactive/disabled text
theme[inactive_fg]="#A8A98F"

# Color of text appearing on top of graphs
theme[graph_text]="#FAFBE1"

# Misc colors for processes, etc.
theme[proc_misc]="#EFF433"

# Cpu box outline color
theme[cpu_box]="#D28813"

# Memory box outline color
theme[mem_box]="#FF0300"

# Net box outline color
theme[net_box]="#D01E6F"

# Proc box outline color
theme[proc_box]="#B235B2"

# Box divider line and small boxes line color
theme[div_line]="#A8A98F"

# Temperature graph colors
theme[temp_start]="#FF0300"
theme[temp_mid]="#D01E6F"
theme[temp_end]="#822664"

# CPU graph colors
theme[cpu_start]="#FF0300"
theme[cpu_mid]="#D28813"
theme[cpu_end]="#EFF433"

# Mem/Disk free meter
theme[free_start]="#FF0300"
theme[free_mid]="#FF0300"
theme[free_end]="#FF0300"

# Mem/Disk cached meter
theme[cached_start]="#D28813"
theme[cached_mid]="#D28813"
theme[cached_end]="#D28813"

# Mem/Disk available meter
theme[available_start]="#D01E6F"
theme[available_mid]="#D01E6F"
theme[available_end]="#D01E6F"

# Mem/Disk used meter
theme[used_start]="#822664"
theme[used_mid]="#822664"
theme[used_end]="#822664"

# Download graph colors
theme[download_start]="#D28813"
theme[download_mid]="#D28813"
theme[download_end]="#EFF433"

# Upload graph colors
theme[upload_start]="#D28813"
theme[upload_mid]="#D28813"
theme[upload_end]="#B235B2"
