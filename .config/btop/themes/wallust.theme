# Btop Wallust Theme

# Main background
theme[main_bg]="#191A1F"

# Main text color
theme[main_fg]="#FEEBE5"

# Title color for boxes
theme[title]="#FEEBE5"

# Highlight color for selected items
theme[hi_fg]="#CE3917"

# Background color of selected item
theme[selected_bg]="#AB9892"

# Text color of selected item
theme[selected_fg]="#F5DAD1"

# Color of inactive/disabled text
theme[inactive_fg]="#AB9892"

# Color of text appearing on top of graphs
theme[graph_text]="#FEEBE5"

# Misc colors for processes, etc.
theme[proc_misc]="#FB6536"

# Cpu box outline color
theme[cpu_box]="#CE3917"

# Memory box outline color
theme[mem_box]="#8C1D2A"

# Net box outline color
theme[net_box]="#31269E"

# Proc box outline color
theme[proc_box]="#3567DD"

# Box divider line and small boxes line color
theme[div_line]="#AB9892"

# Temperature graph colors
theme[temp_start]="#8C1D2A"
theme[temp_mid]="#31269E"
theme[temp_end]="#152B67"

# CPU graph colors
theme[cpu_start]="#8C1D2A"
theme[cpu_mid]="#CE3917"
theme[cpu_end]="#FB6536"

# Mem/Disk free meter
theme[free_start]="#8C1D2A"
theme[free_mid]="#8C1D2A"
theme[free_end]="#8C1D2A"

# Mem/Disk cached meter
theme[cached_start]="#CE3917"
theme[cached_mid]="#CE3917"
theme[cached_end]="#CE3917"

# Mem/Disk available meter
theme[available_start]="#31269E"
theme[available_mid]="#31269E"
theme[available_end]="#31269E"

# Mem/Disk used meter
theme[used_start]="#152B67"
theme[used_mid]="#152B67"
theme[used_end]="#152B67"

# Download graph colors
theme[download_start]="#CE3917"
theme[download_mid]="#CE3917"
theme[download_end]="#FB6536"

# Upload graph colors
theme[upload_start]="#CE3917"
theme[upload_mid]="#CE3917"
theme[upload_end]="#3567DD"
