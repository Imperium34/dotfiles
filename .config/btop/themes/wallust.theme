# Btop Wallust Theme

# Main background
theme[main_bg]="#0D0E0E"

# Main text color
theme[main_fg]="#FFE4B2"

# Title color for boxes
theme[title]="#FFE4B2"

# Highlight color for selected items
theme[hi_fg]="#99581B"

# Background color of selected item
theme[selected_bg]="#AD9260"

# Text color of selected item
theme[selected_fg]="#F7D089"

# Color of inactive/disabled text
theme[inactive_fg]="#AD9260"

# Color of text appearing on top of graphs
theme[graph_text]="#FFE4B2"

# Misc colors for processes, etc.
theme[proc_misc]="#FFA90B"

# Cpu box outline color
theme[cpu_box]="#99581B"

# Memory box outline color
theme[mem_box]="#6F1314"

# Net box outline color
theme[net_box]="#633D15"

# Proc box outline color
theme[proc_box]="#BA6A17"

# Box divider line and small boxes line color
theme[div_line]="#AD9260"

# Temperature graph colors
theme[temp_start]="#6F1314"
theme[temp_mid]="#633D15"
theme[temp_end]="#14472E"

# CPU graph colors
theme[cpu_start]="#6F1314"
theme[cpu_mid]="#99581B"
theme[cpu_end]="#FFA90B"

# Mem/Disk free meter
theme[free_start]="#6F1314"
theme[free_mid]="#6F1314"
theme[free_end]="#6F1314"

# Mem/Disk cached meter
theme[cached_start]="#99581B"
theme[cached_mid]="#99581B"
theme[cached_end]="#99581B"

# Mem/Disk available meter
theme[available_start]="#633D15"
theme[available_mid]="#633D15"
theme[available_end]="#633D15"

# Mem/Disk used meter
theme[used_start]="#14472E"
theme[used_mid]="#14472E"
theme[used_end]="#14472E"

# Download graph colors
theme[download_start]="#99581B"
theme[download_mid]="#99581B"
theme[download_end]="#FFA90B"

# Upload graph colors
theme[upload_start]="#99581B"
theme[upload_mid]="#99581B"
theme[upload_end]="#BA6A17"
