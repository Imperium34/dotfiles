# Btop Wallust Theme

# Main background
theme[main_bg]="#3B2025"

# Main text color
theme[main_fg]="#B0A9AF"

# Title color for boxes
theme[title]="#B0A9AF"

# Highlight color for selected items
theme[hi_fg]="#B82159"

# Background color of selected item
theme[selected_bg]="#5E565C"

# Text color of selected item
theme[selected_fg]="#867C84"

# Color of inactive/disabled text
theme[inactive_fg]="#5E565C"

# Color of text appearing on top of graphs
theme[graph_text]="#B0A9AF"

# Misc colors for processes, etc.
theme[proc_misc]="#1F72E0"

# Cpu box outline color
theme[cpu_box]="#B82159"

# Memory box outline color
theme[mem_box]="#67410F"

# Net box outline color
theme[net_box]="#13A88E"

# Proc box outline color
theme[proc_box]="#24F0DC"

# Box divider line and small boxes line color
theme[div_line]="#5E565C"

# Temperature graph colors
theme[temp_start]="#67410F"
theme[temp_mid]="#13A88E"
theme[temp_end]="#021E08"

# CPU graph colors
theme[cpu_start]="#67410F"
theme[cpu_mid]="#B82159"
theme[cpu_end]="#1F72E0"

# Mem/Disk free meter
theme[free_start]="#67410F"
theme[free_mid]="#67410F"
theme[free_end]="#67410F"

# Mem/Disk cached meter
theme[cached_start]="#B82159"
theme[cached_mid]="#B82159"
theme[cached_end]="#B82159"

# Mem/Disk available meter
theme[available_start]="#13A88E"
theme[available_mid]="#13A88E"
theme[available_end]="#13A88E"

# Mem/Disk used meter
theme[used_start]="#021E08"
theme[used_mid]="#021E08"
theme[used_end]="#021E08"

# Download graph colors
theme[download_start]="#B82159"
theme[download_mid]="#B82159"
theme[download_end]="#1F72E0"

# Upload graph colors
theme[upload_start]="#B82159"
theme[upload_mid]="#B82159"
theme[upload_end]="#24F0DC"
