# Btop Wallust Theme

# Main background
theme[main_bg]="#101112"

# Main text color
theme[main_fg]="#FAFAF8"

# Title color for boxes
theme[title]="#FAFAF8"

# Highlight color for selected items
theme[hi_fg]="#E32A31"

# Background color of selected item
theme[selected_bg]="#A7A8A6"

# Text color of selected item
theme[selected_fg]="#EFF0ED"

# Color of inactive/disabled text
theme[inactive_fg]="#A7A8A6"

# Color of text appearing on top of graphs
theme[graph_text]="#FAFAF8"

# Misc colors for processes, etc.
theme[proc_misc]="#C1F247"

# Cpu box outline color
theme[cpu_box]="#E32A31"

# Memory box outline color
theme[mem_box]="#1A8A82"

# Net box outline color
theme[net_box]="#982472"

# Proc box outline color
theme[proc_box]="#18C68E"

# Box divider line and small boxes line color
theme[div_line]="#A7A8A6"

# Temperature graph colors
theme[temp_start]="#1A8A82"
theme[temp_mid]="#982472"
theme[temp_end]="#14374F"

# CPU graph colors
theme[cpu_start]="#1A8A82"
theme[cpu_mid]="#E32A31"
theme[cpu_end]="#C1F247"

# Mem/Disk free meter
theme[free_start]="#1A8A82"
theme[free_mid]="#1A8A82"
theme[free_end]="#1A8A82"

# Mem/Disk cached meter
theme[cached_start]="#E32A31"
theme[cached_mid]="#E32A31"
theme[cached_end]="#E32A31"

# Mem/Disk available meter
theme[available_start]="#982472"
theme[available_mid]="#982472"
theme[available_end]="#982472"

# Mem/Disk used meter
theme[used_start]="#14374F"
theme[used_mid]="#14374F"
theme[used_end]="#14374F"

# Download graph colors
theme[download_start]="#E32A31"
theme[download_mid]="#E32A31"
theme[download_end]="#C1F247"

# Upload graph colors
theme[upload_start]="#E32A31"
theme[upload_mid]="#E32A31"
theme[upload_end]="#18C68E"
